# Copy to ~/.config/sharon-jones/env and edit.
#
# Values are literal - systemd does no shell parsing here, so do not quote
# them. Writing NAME="My Library" would make the quotes part of the name.
# All four are required: the unit references each one, and an unset variable
# expands to an empty argument.

# Library name shown under Shared in iTunes. Free-form; spaces are fine.
SHARON_JONES_NAME=Sharon Jones and the DAAP King

# Published as <hostname>.local. ASCII letters, digits and - only. Must not
# collide with a name another responder on the machine already defends, in
# particular the system hostname.
SHARON_JONES_HOSTNAME=sharon-jones

# Substring of the DLNA server's friendly name, matched during SSDP discovery.
SHARON_JONES_SERVER=plex

# ContentDirectory ObjectID to browse from. "0" is the server root; see
# "DLNA: picking a good root" in the README for finding a better one.
SHARON_JONES_ROOT=0
